# Puerto donde escucha el servidor Express
PORT=4000

# Mismo tenant de Microsoft Entra ID que usa el front (front-react/.env: VITE_AZURE_TENANT_ID)
AZURE_TENANT_ID=635fce4d-bfca-4393-994d-91819d9056e1

# Client ID de la app "pedidos360-back" (front-react/.env: VITE_API_SCOPE = api://<este-id>/access_as_user)
AZURE_AUDIENCE=37a0afef-4a92-4f3b-a448-585c7994cb08

# Orígenes permitidos para CORS, separados por coma
CORS_ORIGINS=http://localhost:5173,https://pedidos360-front.vercel.app
